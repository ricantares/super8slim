{
  "name": "Python 3.15 Slim DevContainer",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },

  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder}/superenalotto,target=/app/superenalotto,type=bind",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.15"
    }
  },

  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },

  "remoteUser": "vscode"
}
